        Array.prototype.forEach.call(row.getElementsByTagName("c"), function (cell, k) {
          var ref = (cell.getAttribute("r") || "").replace(/\d+/g, ""), col = k;
          if (ref) { col = 0; for (var j = 0; j < ref.length; j++) { col = col * 26 + (ref.charCodeAt(j) - 64); } col -= 1; }
          var type = cell.getAttribute("t") || "", v = cell.getElementsByTagName("v")[0], value = "";
          if (type === "s" && v) { value = shared[parseInt(v.textContent, 10)] || ""; }
          else if (type === "inlineStr") { value = Array.prototype.map.call(cell.getElementsByTagName("t"), function (t) { return t.textContent; }).join(""); }
          else if (v) { value = v.textContent; if (/^-?\d+\.0+$/.test(value)) { value = value.split(".")[0]; } }
          cells[col] = value; max = Math.max(max, col);
        });
        if (max >= 0) { var r = []; for (var x = 0; x <= max; x++) { r.push(cells[x] || ""); } rows.push(r); }
      });
      return rows;
    });
  }

  function importFile(file) {
    var name = file.name.toLowerCase();
    if (file.size > 20 * 1024 * 1024) { toast("The file is larger than 20 MB."); return; }
    var job;
    if (/\.xls[xm]$/.test(name)) { job = file.arrayBuffer().then(readXlsx); }
    else if (/\.json$/.test(name)) { job = file.text().then(function (t) { return jsonRows(JSON.parse(t)); }); }
    else { job = file.text().then(parseCsv); }
    job.then(function (rows) {
      var parsed = fromRows(rows);
      var known = {}; state.controls.forEach(function (c) { known[c.id] = c; });
      var matching = parsed.controls.filter(function (c) { return c.id in known; });
      var previous = state.controls.map(function (c) { return Object.assign({}, c); }), previousTitle = state.title;
      var message;
      if (matching.length && matching.length >= parsed.controls.length / 2) {
        matching.forEach(function (c) { known[c.id].maturity = c.maturity; if (c.notes) { known[c.id].notes = c.notes; } });
        message = "Answers loaded for " + plural(matching.length, "control") + ".";
      } else {
        if (!parsed.hasMapping) { throw new Error("no column maps the controls to MITRE (a \"mitigations\" column such as M1032, or \"techniques\")"); }
        state.controls = parsed.controls;
        state.title = file.name.replace(/\.[^.]+$/, "");
        message = "Questionnaire loaded: " + plural(parsed.controls.length, "control") + ".";
      }
      if (parsed.warnings.length) { message += " " + plural(parsed.warnings.length, "warning") + ": " + parsed.warnings[0]; }
      state.dirty = true;
      renderQuestionnaire();
      renderResults();
      toast(message, { label: "Undo", run: function () { state.controls = previous; state.title = previousTitle; renderQuestionnaire(); renderResults(); } });
    }).catch(function (err) { toast("Could not read " + file.name + ": " + err.message); });
  }

  // ------------------------------------------------------------------ export

  function download(name, type, text) {
    var blob = new Blob([text], { type: type });
    var a = el("a"); a.href = URL.createObjectURL(blob); a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function () { URL.revokeObjectURL(a.href); }, 4000);
    state.dirty = false;
  }
  function csvCell(v) { v = v === null || v === undefined ? "" : String(v); return /[",\n\r;]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; }
  function exportCsv() {
    var rows = [["id", "domain", "control", "description", "mitigations", "techniques", "maturity", "notes"]];
    state.controls.forEach(function (c) {
      rows.push([c.id, c.domain, c.title, c.description, c.mitigations.join(" "), c.techniques.join(" "), c.maturity === null || c.maturity === undefined ? "" : c.maturity, c.notes]);
    });
    download(fileStem() + ".csv", "text/csv;charset=utf-8", "\ufeff" + rows.map(function (r) { return r.map(csvCell).join(","); }).join("\n") + "\n");
  }
  function resultsJson() {
    var r = state.result;
    return {
      title: state.title, scale: SCALE, generated_by: "Vigie " + META.vigie_version, exported_at: new Date().toISOString(),
      controls: state.controls,
      frameworks: r.frameworks.map(function (f) {
        return {
          key: f.fw.key, name: f.fw.label, version: f.fw.version, exposure_index: f.index, counts: f.counts,
          blocked_at: f.blockedAt,
          path: f.path.map(function (s) { return { stage: s.stage.name, technique: s.step ? s.step.t.id : null, name: s.step ? s.step.t.name : null, status: s.status }; })
        };
      }),
      priorities: r.priorities.map(function (p) {
        return { control: p.control.id, title: p.control.title, current: p.control.maturity, target: p.target, relieved: p.relieved, on_path: p.onPath, observed: p.observed };
      })
    };
  }
  function exportMarkdown() {
    var r = state.result, lines = ["# " + (state.title || "Maturity assessment"), ""];
    lines.push(answeredCount() + " of " + state.controls.length + " controls answered, on a 0-" + SCALE + " scale. Vigie " + META.vigie_version + ".", "");
    r.frameworks.forEach(function (f) {
      lines.push("## " + f.fw.label + " " + f.fw.version + " (" + f.fw.scope + ")", "");
      lines.push("Exposure index: " + (f.index === null ? "not assessed" : f.index + "/100") + ". " +
        STATUSES.map(function (s) { return LABELS[s] + ": " + f.counts[s]; }).join(", ") + ".", "");
      lines.push(f.blockedAt ? "The easiest path is blocked at " + f.stages.filter(function (s) { return s.stage.shortname === f.blockedAt; })[0].stage.name + "." : "Nothing blocks the easiest path.", "");
      lines.push("| Stage | Easiest technique | Status |", "|---|---|---|");
      f.path.forEach(function (s) { lines.push("| " + s.stage.name + " | " + (s.step ? s.step.t.id + " " + s.step.t.name : "-") + " | " + LABELS[s.status] + " |"); });
      lines.push("");
    });
    if (r.priorities.length) {
      lines.push("## What to raise first", "");
      r.priorities.forEach(function (p, i) {
        lines.push((i + 1) + ". **" + p.control.id + " " + p.control.title + "**: " + fmtLevel(p.control.maturity) + " → " + p.target + ", stops " + plural(p.relieved.length, "technique") + " from being facilitated" + (p.onPath ? ", " + p.onPath + " on the easiest path" : "") + (p.observed ? ", " + p.observed + " seen in the logs" : "") + ".");
      });
      lines.push("");
    }
    download(fileStem() + ".md", "text/markdown;charset=utf-8", lines.join("\n"));
  }
  function fileStem() { return (state.title || "assessment").replace(/[^\w\- ]+/g, "").trim().replace(/\s+/g, "-").toLowerCase() || "assessment"; }

  // ------------------------------------------------------------------ wiring

  function init() {
    renderLegend();
    fillStatusFilter();
    renderTabs();
    fillStageFilter();
    renderQuestionnaire();
    renderResults();
    var v = $("versions");
    v.textContent = DATA.frameworks.map(function (f) { return f.label + " " + f.version; }).join(", ") + ". Scale 0-" + SCALE + ": " +
      META.levels.slice(0, Math.min(META.levels.length, 11)).map(function (n, i) { return i + " " + n; }).join(", ") + ".";
    if (DATA.warnings && DATA.warnings.length) {
      var w = $("warnings"); w.hidden = false;
      w.textContent = plural(DATA.warnings.length, "warning") + " while reading the questionnaire: " + DATA.warnings.slice(0, 3).join("; ") + (DATA.warnings.length > 3 ? "…" : "");
    }

    $("q-search").addEventListener("input", filterControls);
    $("q-domain").addEventListener("change", filterControls);
    $("q-open").addEventListener("change", filterControls);
    $("q-bulk").addEventListener("change", function () {
      var value = $("q-bulk").value; if (value === "") { return; }
      var level = Number(value), changed = [];
      state.controls.forEach(function (c) { if (c.maturity === null || c.maturity === undefined) { changed.push(c); c.maturity = level; } });
      $("q-bulk").value = "";
      renderQuestionnaire(); renderResults(); state.dirty = true;
      toast(plural(changed.length, "unanswered control") + " set to " + levelName(level) + ".", { label: "Undo", run: function () { changed.forEach(function (c) { c.maturity = null; }); renderQuestionnaire(); renderResults(); } });
    });
    ["t-search", "t-status", "t-stage"].forEach(function (id) {
      $(id).addEventListener(id === "t-search" ? "input" : "change", function () { state.techLimit = 120; renderTechniques(); });
    });
    $("import").addEventListener("change", function (e) { var f = e.target.files[0]; if (f) { importFile(f); } e.target.value = ""; });
    var menuBtn = $("export-btn"), menu = $("export-menu");
    menuBtn.addEventListener("click", function () { var open = menu.hidden; menu.hidden = !open; menuBtn.setAttribute("aria-expanded", String(open)); });
    document.addEventListener("click", function (e) { if (!menu.hidden && !menu.contains(e.target) && !menuBtn.contains(e.target)) { menu.hidden = true; menuBtn.setAttribute("aria-expanded", "false"); } });
    menu.addEventListener("click", function (e) {
      var kind = e.target.getAttribute("data-export"); if (!kind) { return; }
      menu.hidden = true; menuBtn.setAttribute("aria-expanded", "false");
      if (kind === "csv") { exportCsv(); }
      else if (kind === "json") { download(fileStem() + ".json", "application/json", JSON.stringify(resultsJson(), null, 2)); }
      else { exportMarkdown(); }
    });
    $("print").addEventListener("click", function () { window.print(); });
    var opened = [];
    window.addEventListener("beforeprint", function () { opened = []; document.querySelectorAll(".domain:not([open])").forEach(function (d) { opened.push(d); d.open = true; }); });
    window.addEventListener("afterprint", function () { opened.forEach(function (d) { d.open = false; }); });
    $("theme").addEventListener("click", function () {
      var root = document.documentElement;
      var dark = root.getAttribute("data-theme") === "dark" || (!root.getAttribute("data-theme") && window.matchMedia("(prefers-color-scheme: dark)").matches);
      var next = dark ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem("vigie-theme", next); } catch (e) { /* storage unavailable */ }
    });
    $("drawer-close").addEventListener("click", closeDrawer);
    $("scrim").addEventListener("click", closeDrawer);
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !$("drawer").hidden) { closeDrawer(); } });
  }

  init();
})();
