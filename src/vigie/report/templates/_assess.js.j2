{% raw %}
(function () {
  "use strict";

  var DATA = JSON.parse(document.getElementById("vigie-data").textContent);
  var META = DATA.meta;
  var SCALE = META.scale;
  var FACILITATED_BELOW = META.facilitated_below;
  var HINDERED_FROM = META.hindered_from;
  var STATUSES = ["facilitated", "unpreventable", "partial", "hindered", "unassessed"];
  var LABELS = META.status_labels;
  var SHORT = { facilitated: "Facilitated", unpreventable: "No control", partial: "Partly hindered", hindered: "Hindered", unassessed: "Not assessed" };
  var HINTS = {
    facilitated: "A control gap leaves the technique without its main counter-measure.",
    unpreventable: "MITRE lists no preventive mitigation: detection is the defense.",
    partial: "Its best counter-measure is in place, but not fully.",
    hindered: "A mature control counters it.",
    unassessed: "None of its mitigations was assessed."
  };
  var PRIORITY_LIMIT = 12;
  var PRE_COMPROMISE = ["reconnaissance", "resource-development", "ai-attack-adaptation"];
  var MITIGATION_ID = /\b(AML\.M\d{4}|M\d{4})\b/gi;
  var TECHNIQUE_ID = /\b(AML\.T\d{4}(?:\.\d{3})?|T\d{4}(?:\.\d{3})?)\b/gi;
  var NOT_ASSESSED = ["", "-", "n/a", "na", "n.a.", "none", "?", "nc", "n/c", "not assessed", "nan", "–"];

  var state = {
    controls: DATA.controls.map(function (c) { return Object.assign({}, c); }),
    title: META.title,
    fw: "attack",
    result: null,
    dirty: false,
    techLimit: 120
  };
  var FW = {};
  DATA.frameworks.forEach(function (f) { FW[f.key] = f; });

  // ------------------------------------------------------------------ engine
  // The same rules as vigie/assess/engine.py: keep them in step.

  function parentId(id) {
    id = String(id).toUpperCase();
    if (id.indexOf("AML.") === 0) { return id.split(".").slice(0, 2).join("."); }
    return id.split(".")[0];
  }

  function statusOf(level) {
    if (level === null || level === undefined) { return "unassessed"; }
    var ratio = level / SCALE;
    if (ratio < FACILITATED_BELOW) { return "facilitated"; }
    if (ratio < HINDERED_FROM) { return "partial"; }
    return "hindered";
  }

  function targetLevel() { return Math.ceil(HINDERED_FROM * SCALE - 1e-9); }

  function round(value, digits) { var f = Math.pow(10, digits); return Math.round(value * f) / f; }

  function levels(controls) {
    var byMitigation = {}, byTechnique = {};
    controls.forEach(function (c) {
      if (c.maturity === null || c.maturity === undefined) { return; }
      c.mitigations.forEach(function (m) {
        byMitigation[m] = Math.max(m in byMitigation ? byMitigation[m] : -1, c.maturity);
      });
      c.techniques.forEach(function (t) {
        var key = parentId(t);
        byTechnique[key] = Math.max(key in byTechnique ? byTechnique[key] : -1, c.maturity);
      });
    });
    return { mitigation: byMitigation, technique: byTechnique };
  }

  function evaluate(t, controls, lv, seen) {
    var mapped = controls.filter(function (c) {
      return c.mitigations.some(function (m) { return t.mitigations.indexOf(m) >= 0; }) ||
        c.techniques.some(function (x) { return parentId(x) === t.id; });
    });
    var implemented = {};
    mapped.forEach(function (c) { c.mitigations.forEach(function (m) { implemented[m] = true; }); });
    var uncovered = t.mitigations.filter(function (m) { return !implemented[m]; });
    var found = t.mitigations.filter(function (m) { return m in lv.mitigation; })
      .map(function (m) { return lv.mitigation[m]; });
    if (t.id in lv.technique) { found.push(lv.technique[t.id]); }
    var level = found.length ? Math.max.apply(null, found) : null;
    var direct = mapped.some(function (c) {
      return c.techniques.some(function (x) { return parentId(x) === t.id; });
    });
    var status, exposure;
    if (!t.preventable && !direct) { status = "unpreventable"; exposure = 1; }
    else {
      status = statusOf(level);
      exposure = level === null ? null : round(1 - level / SCALE, 4);
    }
    return {
      t: t, status: status, level: level, exposure: exposure,
      controls: mapped.map(function (c) { return c.id; }), uncovered: uncovered,
      observed: seen[t.id] || 0
    };
  }

  function rank(a, b) {
    var ea = a.exposure === null ? -1 : a.exposure, eb = b.exposure === null ? -1 : b.exposure;
    if (eb !== ea) { return eb - ea; }
    if (b.observed !== a.observed) { return b.observed - a.observed; }
    if (b.t.weight !== a.t.weight) { return b.t.weight - a.t.weight; }
    return a.t.id < b.t.id ? -1 : a.t.id > b.t.id ? 1 : 0;
  }

  function stepOf(members) {
    var wanted = [["facilitated"], ["unpreventable"], ["partial", "hindered"]];
    for (var i = 0; i < wanted.length; i++) {
      for (var j = 0; j < members.length; j++) {
        if (wanted[i].indexOf(members[j].status) >= 0) { return members[j]; }
      }
    }
    return members.length ? members[0] : null;
  }

  function share(members) {
    var assessed = members.filter(function (m) { return m.status === "facilitated" || m.status === "partial" || m.status === "hindered"; });
    var total = assessed.reduce(function (s, m) { return s + m.t.weight; }, 0);
    if (!total) { return null; }
    var fac = assessed.filter(function (m) { return m.status === "facilitated"; })
      .reduce(function (s, m) { return s + m.t.weight; }, 0);
    return round(fac / total, 4);
  }

  function emptyCounts() { var c = {}; STATUSES.forEach(function (s) { c[s] = 0; }); return c; }

  function computeFramework(fw, controls, lv, seen) {
    var evaluated = fw.techniques.map(function (t) { return evaluate(t, controls, lv, seen); });
    var stages = [], blockedAt = null;
    fw.stages.forEach(function (stage) {
      var members = evaluated.filter(function (r) { return r.t.stages.indexOf(stage.shortname) >= 0; }).sort(rank);
      var counts = emptyCounts();
      members.forEach(function (m) { counts[m.status] += 1; });
      var step = stepOf(members);
      var status = step ? step.status : "unassessed";
      if (status === "hindered" && blockedAt === null) { blockedAt = stage.shortname; }
      stages.push({
        stage: stage, techniques: members, counts: counts, share: share(members), step: step,
        status: status, observed: members.reduce(function (s, m) { return s + m.observed; }, 0)
      });
    });
    var counts = emptyCounts();
    evaluated.forEach(function (r) { counts[r.status] += 1; });
    var preventable = evaluated.filter(function (r) { return r.status === "facilitated" || r.status === "partial" || r.status === "hindered"; });
    var weight = preventable.reduce(function (s, r) { return s + r.t.weight; }, 0);
    var index = weight ? Math.floor(100 * preventable.reduce(function (s, r) { return s + r.t.weight * (r.exposure || 0); }, 0) / weight + 0.5) : null;
    var path = [];
    for (var i = 0; i < stages.length; i++) {
      if (!stages[i].step) { continue; }
      path.push(stages[i]);
      if (stages[i].stage.shortname === blockedAt) { break; }
    }
    return {
      fw: fw, stages: stages, blockedAt: blockedAt, index: index, counts: counts,
      assessed: preventable.length, path: path, evaluated: evaluated
    };
  }

  function compute(controls) {
    var seen = {};
    Object.keys(DATA.observed || {}).forEach(function (id) {
      var key = parentId(id);
      seen[key] = (seen[key] || 0) + DATA.observed[id];
    });
    var lv = levels(controls);
    var results = DATA.frameworks.map(function (fw) { return computeFramework(fw, controls, lv, seen); });
    var target = targetLevel();
    var onPath = {};
    results.forEach(function (r) { r.path.forEach(function (s) { if (s.step) { onPath[s.step.t.id] = true; } }); });
    var byId = {};
    results.forEach(function (r) { r.evaluated.forEach(function (e) { byId[e.t.id] = e; }); });
    var ids = Object.keys(byId).sort();
    var priorities = [];
    controls.forEach(function (c) {
      if (c.maturity === null || c.maturity === undefined || c.maturity >= target) { return; }
      var relieved = [], gain = 0, pathCount = 0, observed = 0;
      ids.forEach(function (id) {
        var e = byId[id];
        if (e.status !== "facilitated" || e.controls.indexOf(c.id) < 0) { return; }
        if (statusOf(target) === "facilitated") { return; }
        relieved.push(id);
        var factor = 1;
        if (onPath[id]) { factor *= 2; pathCount += 1; }
        if (e.observed) { factor *= 3; observed += 1; }
        if (e.t.stages.every(function (s) { return PRE_COMPROMISE.indexOf(s) >= 0; })) { factor *= 0.5; }
        gain += e.t.weight * factor;
      });
      if (relieved.length) {
        priorities.push({ control: c, target: target, relieved: relieved, onPath: pathCount, observed: observed, gain: round(gain, 3) });
      }
    });
    priorities.sort(function (a, b) {
      if (b.gain !== a.gain) { return b.gain - a.gain; }
      if (b.relieved.length !== a.relieved.length) { return b.relieved.length - a.relieved.length; }
      return a.control.id < b.control.id ? -1 : a.control.id > b.control.id ? 1 : 0;
    });
    var seenOpen = {};
    results.forEach(function (r) {
      r.evaluated.forEach(function (e) {
        if (e.observed && (e.status === "facilitated" || e.status === "unpreventable")) { seenOpen[e.t.id] = e; }
      });
    });
    var observedOpen = Object.keys(seenOpen).map(function (k) { return seenOpen[k]; })
      .sort(function (a, b) { return b.observed - a.observed || (a.t.id < b.t.id ? -1 : 1); });
    return { frameworks: results, priorities: priorities.slice(0, PRIORITY_LIMIT), byId: byId, observedOpen: observedOpen, seen: seen };
  }

  // Exposed for the tests, which run this file in Node and compare with Python.
  if (typeof window.__vigieAssessTest === "function") {
    window.__vigieAssessTest({ compute: compute, state: state, DATA: DATA });
    return;
  }

  // -------------------------------------------------------------------- DOM helpers

  function $(id) { return document.getElementById(id); }
  function el(tag, cls, text) {
    var node = document.createElement(tag);
    if (cls) { node.className = cls; }
    if (text !== undefined && text !== null) { node.textContent = text; }
    return node;
  }
  function add(parent) { for (var i = 1; i < arguments.length; i++) { var c = arguments[i]; if (c === null || c === undefined) { continue; } parent.appendChild(typeof c === "string" ? document.createTextNode(c) : c); } return parent; }
  function svgUse(id, cls) {
    var ns = "http://www.w3.org/2000/svg";
    var svg = document.createElementNS(ns, "svg"); svg.setAttribute("class", cls || "icon"); svg.setAttribute("aria-hidden", "true");
    var use = document.createElementNS(ns, "use"); use.setAttribute("href", "#" + id); svg.appendChild(use); return svg;
  }
  function plural(n, word, many) { return n + " " + (n === 1 ? word : (many || word + "s")); }
  function fmtLevel(v) { return v === null || v === undefined ? "–" : (Math.round(v * 100) / 100).toString(); }
  function pill(status, text) {
    var p = el("span", "pill f-" + status); add(p, el("i"), text || LABELS[status]); return p;
  }
  function levelName(v) {
    if (v === null || v === undefined) { return "Not assessed"; }
    var names = META.levels;
    return Number.isInteger(v) && names[v] ? v + " · " + names[v] : String(v);
  }
  function safeUrl(u) { return /^https:\/\//.test(u || "") ? u : null; }
  function link(url, text, cls) {
    var href = safeUrl(url);
    var a = el(href ? "a" : "span", cls || "", text);
    if (href) { a.href = href; a.rel = "noreferrer"; a.target = "_blank"; }
    return a;
  }
  var toastTimer = null;
  function toast(text, action) {
    var t = $("toast"); t.textContent = text;
    if (action) {
      var b = el("button", "btn btn-sm", action.label); b.style.marginLeft = "12px";
      b.addEventListener("click", function () { action.run(); t.classList.remove("show"); });
      t.appendChild(b);
    }
    t.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { t.classList.remove("show"); }, action ? 7000 : 3500);
  }
  function animateNumber(node, to) {
    var from = parseFloat(node.getAttribute("data-v"));
    node.setAttribute("data-v", to === null ? "" : to);
    if (to === null) { node.textContent = "–"; return; }
    if (isNaN(from) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) { node.textContent = to; return; }
    var start = performance.now(), dur = 420;
    function frame(now) {
      var k = Math.min(1, (now - start) / dur), e = 1 - Math.pow(1 - k, 3);
      node.textContent = Math.round(from + (to - from) * e);
      if (k < 1) { requestAnimationFrame(frame); }
    }
    requestAnimationFrame(frame);
  }

  // ------------------------------------------------------------------ rendering

  var pending = false;
  function refresh() {
    if (pending) { return; }
    pending = true;
    requestAnimationFrame(function () { pending = false; renderResults(); });
  }

  function answeredCount() { return state.controls.filter(function (c) { return c.maturity !== null && c.maturity !== undefined; }).length; }

  function renderResults() {
    state.result = compute(state.controls);
    renderHero();
    renderGauges();
    renderKpis();
    renderChain();
    renderImpacts();
    renderPriorities();
    renderObserved();
    renderTechniques();
  }

  function current() {
    return state.result.frameworks.filter(function (r) { return r.fw.key === state.fw; })[0];
  }

  function renderHero() {
    var total = state.controls.length, answered = answeredCount();
    $("q-title").textContent = state.title || "Maturity assessment";
    $("q-progress").textContent = answered + " of " + plural(total, "control") + " answered";
    $("answered-bar").style.width = (total ? 100 * answered / total : 0) + "%";
    var h = $("headline"), lede = $("lede");
    h.textContent = ""; lede.textContent = "";
    var all = state.result.frameworks;
    var fac = all.reduce(function (s, r) { return s + r.counts.facilitated; }, 0);
    var assessed = all.reduce(function (s, r) { return s + r.assessed; }, 0);
    if (!answered) {
      h.textContent = "Rate your controls to see where an attack would get through";
      lede.textContent = "Each control maps to the MITRE ATT&CK and ATLAS techniques it counters. As you rate them, the page shows which techniques your maturity leaves facilitated and the easiest way through an attack, stage by stage.";
      return;
    }
    if (fac) {
      add(h, el("em", "", plural(fac, "technique")), " facilitated by the current maturity");
    } else {
      h.textContent = "No assessed technique is facilitated";
    }
    var r = current();
    var parts = [];
    parts.push("Of the " + plural(assessed, "technique") + " controls can prevent that were assessed, " + fac + " " + (fac === 1 ? "is" : "are") + " facilitated.");
    if (r.assessed) {
      if (r.blockedAt) {
        parts.push(" In " + r.fw.label + ", the easiest path is blocked at " + r.fw.stages.filter(function (s) { return s.shortname === r.blockedAt; })[0].name + ".");
      } else {
        parts.push(" In " + r.fw.label + ", the easiest path goes through all " + r.stages.length + " stages of an attack.");
      }
    }
    var top = state.result.priorities[0];
    if (top) {
      parts.push(" Raising " + top.control.title + " to level " + top.target + " would relieve " + plural(top.relieved.length, "technique") + ".");
    }
    lede.textContent = parts.join("");
  }

  function gaugeColor(v) {
    if (v === null) { return "var(--s-unassessed)"; }
    if (v >= 60) { return "var(--s-facilitated)"; }
    if (v >= 30) { return "var(--s-partial)"; }
    return "var(--s-hindered)";
  }

  function renderGauges() {
    var box = $("gauges");
    if (!box.childNodes.length) {
      state.result.frameworks.forEach(function (r) {
        var b = el("button", "gauge"); b.type = "button"; b.setAttribute("data-fw", r.fw.key);
        b.innerHTML = '<svg viewBox="0 0 120 120" aria-hidden="true"><circle class="track" cx="60" cy="60" r="50" fill="none" stroke-width="11"/>' +
          '<circle class="arc" cx="60" cy="60" r="50" fill="none" stroke-width="11" transform="rotate(-90 60 60)" stroke-dasharray="314.16" stroke-dashoffset="314.16"/>' +
          '<text class="num" x="60" y="64" text-anchor="middle" data-v="">–</text><text class="of" x="60" y="82" text-anchor="middle">out of 100</text></svg>';
        add(b, el("b", "", "Exposure · " + (r.fw.key === "attack" ? "ATT&CK" : "ATLAS")), el("span", "", r.fw.scope));
        b.addEventListener("click", function () { selectFramework(r.fw.key); });
        box.appendChild(b);
      });
    }
    state.result.frameworks.forEach(function (r) {
      var b = box.querySelector('[data-fw="' + r.fw.key + '"]');
      b.setAttribute("aria-pressed", r.fw.key === state.fw ? "true" : "false");
      b.setAttribute("aria-label", "Exposure index " + (r.fw.key === "attack" ? "ATT&CK" : "ATLAS") + ": " + (r.index === null ? "not assessed" : r.index + " out of 100"));
      var arc = b.querySelector(".arc");
      arc.style.stroke = gaugeColor(r.index);
      arc.setAttribute("stroke-dashoffset", String(314.16 * (1 - (r.index || 0) / 100)));
      animateNumber(b.querySelector(".num"), r.index);
    });
  }

  function renderKpis() {
    var box = $("kpis"), r = current();
    if (!box.childNodes.length) {
      STATUSES.forEach(function (s) {
        var k = el("button", "kpi f-" + s); k.type = "button"; k.setAttribute("data-status", s);
        add(k, el("span", "n"), el("span", "l", LABELS[s]), el("span", "d", HINTS[s]));
        k.addEventListener("click", function () {
          $("t-status").value = s; renderTechniques();
          $("techniques").scrollIntoView({ behavior: "smooth" });
        });
        box.appendChild(k);
      });
    }
    STATUSES.forEach(function (s) {
      var n = box.querySelector('[data-status="' + s + '"] .n');
      animateNumber(n, r.counts[s]);
    });
  }

  function renderTabs() {
    var tabs = $("fw-tabs"); tabs.textContent = "";
    DATA.frameworks.forEach(function (fw) {
      var b = el("button"); b.type = "button"; b.setAttribute("role", "tab");
      b.setAttribute("aria-selected", fw.key === state.fw ? "true" : "false");
      add(b, fw.scope + " ", el("small", "", "· " + (fw.key === "attack" ? "ATT&CK " : "ATLAS ") + fw.version));
      b.addEventListener("click", function () { selectFramework(fw.key); });
      tabs.appendChild(b);
    });
  }

  function selectFramework(key) {
    state.fw = key;
    renderTabs();
    fillStageFilter();
    renderResults();
  }

  function renderLegend() {
    var ul = $("legend");
    STATUSES.forEach(function (s) {
      var li = el("li", "f-" + s); add(li, el("i"), LABELS[s]); ul.appendChild(li);
    });
  }

  function renderChain() {
    var r = current(), list = $("chain-list"), verdict = $("path-verdict");
    list.textContent = ""; verdict.textContent = "";
    if (!r.assessed && !answeredCount()) {
      verdict.textContent = "Rate a few controls below: the chain fills in as you go.";
    } else if (r.blockedAt) {
      var name = r.fw.stages.filter(function (s) { return s.shortname === r.blockedAt; })[0].name;
      add(verdict, "The easiest path is ", el("span", "blocked", "blocked at " + name), ": even its easiest technique is hindered by a mature control.");
    } else {
      var open = r.path.filter(function (s) { return s.status === "facilitated"; }).length;
      add(verdict, el("span", "open", "Nothing blocks the easiest path"), ": " + open + " of its " + r.path.length + " stages go through a facilitated technique.");
    }
    var beyond = false;
    r.stages.forEach(function (s, i) {
      var li = el("li", "f-" + s.status);
      var onPath = !beyond && !!s.step;
      if (onPath) { li.classList.add("on-path"); }
      var b = el("button", "node f-" + s.status + (onPath ? " on-path" : "") + (beyond ? " beyond" : ""));
      b.type = "button";
      li.style.animationDelay = (i * 25) + "ms";
      var top = el("div", "top");
      add(top, el("span", "idx", (i < 9 ? "0" : "") + (i + 1)), el("span", "st", SHORT[s.status]));
      add(b, top, el("span", "stage", s.stage.name));
      var step = el("span", "step");
      if (s.step) { add(step, s.step.t.name + " ", el("code", "", s.step.t.id)); }
      else { step.textContent = "No technique"; }
      add(b, step);
      var bar = el("span", "bar");
      var assessed = s.counts.facilitated + s.counts.partial + s.counts.hindered;
      var i2 = el("i"); i2.style.width = (s.share === null ? 0 : Math.round(s.share * 100)) + "%"; bar.appendChild(i2);
      b.appendChild(bar);
      var meta = el("span", "meta");
      add(meta, el("span", "", assessed ? s.counts.facilitated + " of " + assessed + " facilitated" : plural(s.techniques.length, "technique")));
      if (s.observed) {
        var seen = el("span", "seen"); add(seen, svgUse("i-eye"), String(s.observed)); seen.title = plural(s.observed, "alert") + " in the logs";
        meta.appendChild(seen);
      }
      b.appendChild(meta);
      if (s.stage.shortname === r.blockedAt) {
        var rib = el("span", "ribbon"); add(rib, svgUse("i-shield"), "Blocked here"); b.appendChild(rib);
        beyond = true;
      }
      b.setAttribute("aria-label", (i + 1) + ". " + s.stage.name + ": " + LABELS[s.status] + (s.step ? ", easiest technique " + s.step.t.name : ""));
      b.addEventListener("click", function () { openStage(s); });
      li.appendChild(b);
      list.appendChild(li);
    });
  }

  function mitigationChip(id, lv) {
    var m = DATA.mitigations[id] || { name: id, url: "" };
    var c = link(m.url, "", "chip" + (id in lv.mitigation ? "" : " gap"));
    add(c, el("b", "", id), m.name);
    if (id in lv.mitigation) { add(c, el("span", "lv", " · " + fmtLevel(lv.mitigation[id]))); }
    else { c.title = "No control of the questionnaire implements it"; }
    return c;
  }

  function techniqueBlock(e, lv) {
    var box = el("div", "tech");
    var head = el("div", "tech-head");
    add(head, el("span", "nm", e.t.name), link(e.t.url, e.t.id));
    add(box, head);
    var line = el("div", "chips");
    add(line, pill(e.status), el("span", "chip", "Best level " + fmtLevel(e.level)), el("span", "chip", e.t.prevalence));
    if (e.observed) { var o = el("span", "chip gap"); add(o, svgUse("i-eye"), plural(e.observed, "alert") + " in the logs"); line.appendChild(o); }
    box.appendChild(line);
    if (e.t.summary) { box.appendChild(el("p", "why", e.t.summary)); }
    if (e.t.mitigations.length) {
      var ms = el("div", "chips");
      e.t.mitigations.forEach(function (m) { ms.appendChild(mitigationChip(m, lv)); });
      box.appendChild(ms);
    } else {
      box.appendChild(el("p", "why", "MITRE lists no preventive mitigation for this technique: detection and response are the defenses."));
    }
    return box;
  }

  var lastFocus = null;
  function openDrawer(eyebrow, title, body) {
    lastFocus = document.activeElement;
