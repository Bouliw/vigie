    var n = parseFloat(m[1]);
    return Number.isInteger(n) ? n : Math.round(n * 100) / 100;
  }

  function fromRows(rows) {
    rows = rows.map(function (r) { return r.map(function (c) { return String(c === undefined || c === null ? "" : c).trim(); }); });
    var best = { index: 0, cols: {} };
    for (var i = 0; i < Math.min(rows.length, 30); i++) {
      var cols = columnsOf(rows[i]);
      if (Object.keys(cols).length > Object.keys(best.cols).length) { best = { index: i, cols: cols }; }
      if (("maturity" in cols) && (("mitigations" in cols) || ("techniques" in cols))) { best = { index: i, cols: cols }; break; }
    }
    var c = best.cols;
