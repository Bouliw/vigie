    rows.slice(best.index + 1).forEach(function (row, k) {
      if (!row.some(Boolean)) { return; }
      var get = function (key) { return key in c ? (row[c[key]] || "") : ""; };
      var id = get("id") || "C" + (controls.length + 1);
