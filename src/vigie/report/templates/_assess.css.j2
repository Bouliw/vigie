{% include "_tokens.css.j2" %}
{% raw %}
:root {
  --s-facilitated: var(--critical); --s-facilitated-soft: var(--critical-soft);
  --s-unpreventable: var(--high); --s-unpreventable-soft: var(--high-soft);
  --s-partial: var(--medium); --s-partial-soft: var(--medium-soft);
  --s-hindered: var(--new); --s-hindered-soft: var(--new-soft);
  --s-unassessed: var(--informational); --s-unassessed-soft: var(--informational-soft);
  --radius: 14px;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-padding-top: 84px; scroll-behavior: smooth; }
body {
  margin: 0; background: var(--paper); color: var(--ink);
  font: 15px/1.55 var(--font); font-variant-numeric: tabular-nums;
  -webkit-font-smoothing: antialiased;
}
a { color: var(--accent); text-underline-offset: .18em; text-decoration-thickness: 1px; }
a:hover { text-decoration-thickness: 2px; }
code { font-family: var(--mono); font-size: .86em; background: var(--sunken); padding: 1px 5px; border-radius: 5px; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px; }
button, input, select { font: inherit; color: inherit; }
[hidden] { display: none !important; }
.no-js .js-only { display: none !important; }
.no-js #app { display: none; }
.visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden;
  clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
.muted { color: var(--muted); }
.small { font-size: 13px; }
.wrap { max-width: 1240px; margin: 0 auto; padding: 0 24px; }
.icon { width: 16px; height: 16px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8;
  stroke-linecap: round; stroke-linejoin: round; }

/* Masthead */
.framed .masthead .brand { visibility: hidden; width: 0; overflow: hidden; margin-right: auto; }
.masthead { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--surface) 88%, transparent);
  backdrop-filter: saturate(1.6) blur(12px); -webkit-backdrop-filter: saturate(1.6) blur(12px);
  border-bottom: 1px solid var(--line); }
.masthead .wrap { display: flex; align-items: center; gap: 16px; min-height: 60px; flex-wrap: wrap; }
.brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 17px;
  letter-spacing: -.01em; color: var(--ink); text-decoration: none; margin-right: auto; }
.brand svg { width: 26px; height: 26px; }
.brand small { font-weight: 500; color: var(--muted); font-size: 15px; letter-spacing: 0; }
.jump { display: flex; gap: 2px; flex-wrap: wrap; margin: 0; padding: 0; list-style: none; }
.jump a { display: block; padding: 6px 10px; border-radius: 8px; color: var(--ink-2); text-decoration: none; font-size: 14px; }
.jump a:hover { background: var(--sunken); color: var(--ink); }
.actions { display: flex; gap: 4px; align-items: center; }

/* Buttons and controls */
.btn, .seg button, .node, .lvl span, .prio, .chip { transition: transform .45s var(--spring), background-color .15s,
  border-color .15s, color .15s, box-shadow .2s, opacity .2s; }
.btn:active, .seg button:active, .node:active { transform: scale(.97); transition-duration: .08s; }
.btn { display: inline-flex; align-items: center; gap: 7px; height: 36px; padding: 0 14px;
  border: 1px solid var(--line-strong); border-radius: 10px; background: var(--surface);
  font-size: 14px; font-weight: 550; cursor: pointer; white-space: nowrap; }
.btn:hover { border-color: var(--ink-2); }
.btn-quiet { border-color: transparent; background: transparent; color: var(--ink-2); }
.btn-quiet:hover { background: var(--sunken); border-color: transparent; color: var(--ink); }
.btn-icon { width: 36px; padding: 0; justify-content: center; }
.btn-primary { background: var(--accent); border-color: var(--accent); color: var(--accent-on); }
.btn-primary:hover { filter: brightness(1.08); border-color: var(--accent); }
.btn-sm { height: 30px; padding: 0 11px; font-size: 13px; border-radius: 8px; }
.menu { position: relative; }
.menu-list { position: absolute; right: 0; top: 42px; min-width: 260px; padding: 6px; background: var(--surface);
  border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow-lift); z-index: 30;
  animation: pop .22s var(--ease-out); }
.menu-list button { display: block; width: 100%; text-align: left; padding: 9px 12px; border: 0; border-radius: 8px;
  background: transparent; cursor: pointer; font-size: 14px; }
.menu-list button:hover { background: var(--sunken); }
select, input[type="search"], input[type="number"] { height: 38px; padding: 0 12px; border: 1px solid var(--line-strong);
  border-radius: 10px; background: var(--surface); font-size: 14px; }
select { padding-right: 28px; }
input[type="search"]:focus, select:focus { outline: 2px solid var(--accent); outline-offset: 0; border-color: transparent; }
.toggle { display: inline-flex; gap: 8px; align-items: center; font-size: 14px; color: var(--ink-2); cursor: pointer; }
.banner { margin: 16px 0; padding: 12px 16px; border-radius: 12px; background: var(--accent-soft); font-size: 14px; }
.banner.warn { background: var(--medium-soft); }

/* Hero */
.hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px; align-items: end; padding: 44px 0 24px; }
.eyebrow { margin: 0 0 10px; font-size: 13px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
.eyebrow .dot { margin: 0 4px; }
.hero h1 { margin: 0; font-size: clamp(30px, 4.2vw, 50px); line-height: 1.06; letter-spacing: -.035em; font-weight: 750; max-width: 18ch; text-wrap: balance; }
.hero h1 em { font-style: normal; color: var(--s-facilitated); }
.lede { margin: 16px 0 0; max-width: 64ch; font-size: 17px; color: var(--ink-2); text-wrap: pretty; }
.answered { margin-top: 22px; height: 6px; max-width: 520px; border-radius: 99px; background: var(--sunken); overflow: hidden; }
.answered i { display: block; height: 100%; width: 0; border-radius: inherit; background: var(--accent); transition: width .6s var(--ease-out); }
.gauges { display: flex; gap: 18px; }
.gauge { width: 172px; padding: 18px 16px 14px; border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow);
  border: 1px solid var(--line); text-align: center; cursor: pointer; }
.gauge[aria-pressed="true"] { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), var(--shadow); }
.gauge svg { width: 120px; height: 120px; display: block; margin: 0 auto; }
.gauge .track { stroke: var(--sunken); }
.gauge .arc { transition: stroke-dashoffset .9s var(--ease-out), stroke .3s; stroke-linecap: round; }
.gauge .num { font-size: 30px; font-weight: 750; letter-spacing: -.03em; fill: var(--ink); }
.gauge .of { font-size: 11px; fill: var(--muted); }
.gauge b { display: block; margin-top: 6px; font-size: 14px; }
.gauge span { display: block; font-size: 12px; color: var(--muted); }

/* KPIs */
.kpis { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin: 8px 0 8px; }
.kpi { position: relative; display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-start; padding: 16px 18px 14px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line);
  box-shadow: var(--shadow); text-align: left; cursor: pointer; overflow: hidden; }
.kpi::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--c); }
.kpi:hover { box-shadow: var(--shadow-lift); }
.kpi .n { display: block; font-size: 30px; font-weight: 750; letter-spacing: -.03em; line-height: 1.1; }
.kpi .l { display: block; margin-top: 4px; font-size: 14px; font-weight: 600; }
.kpi .d { display: block; margin-top: 2px; font-size: 12.5px; color: var(--muted); line-height: 1.4; }

/* Sections */
.section { margin: 40px 0 0; padding: 28px; border-radius: 20px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); }
.section-head { display: flex; gap: 24px; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; margin-bottom: 18px; }
.section-head h2 { margin: 0; font-size: 23px; letter-spacing: -.02em; }
.section-head p { margin: 6px 0 0; color: var(--ink-2); max-width: 78ch; font-size: 14.5px; }
.seg { display: inline-flex; padding: 3px; gap: 2px; border-radius: 12px; background: var(--sunken); }
.seg button { border: 0; background: transparent; padding: 7px 14px; border-radius: 9px; font-size: 14px; font-weight: 550; cursor: pointer; color: var(--ink-2); }
.seg button[aria-selected="true"] { background: var(--surface); color: var(--ink); box-shadow: var(--shadow); }
.seg button small { color: var(--muted); font-weight: 500; }
.legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0 0 14px; padding: 0; list-style: none; font-size: 13px; color: var(--ink-2); }
.legend li { display: inline-flex; align-items: center; gap: 7px; }
.legend i, .pill i { width: 10px; height: 10px; border-radius: 3px; background: var(--c); display: inline-block; }

/* Kill chain */
.path-verdict { margin: 0 0 18px; font-size: 16px; font-weight: 600; }
.path-verdict .blocked { color: var(--s-hindered); }
.path-verdict .open { color: var(--s-facilitated); }
.chain { display: grid; grid-template-columns: repeat(auto-fill, minmax(178px, 1fr)); gap: 14px 22px; margin: 0; padding: 0; list-style: none; counter-reset: stage; }
.chain li { position: relative; display: flex; }
.chain li:not(:last-child)::after { content: ""; position: absolute; right: -16px; top: 50%; width: 10px; height: 10px;
  border-top: 2px solid var(--line-strong); border-right: 2px solid var(--line-strong); transform: translateY(-50%) rotate(45deg); }
.chain li.on-path:not(:last-child)::after { border-color: var(--c); }
.node { position: relative; display: flex; flex-direction: column; gap: 6px; width: 100%; min-height: 172px; padding: 14px 14px 12px;
  border: 1px solid var(--line); border-radius: var(--radius); background: var(--raised); cursor: pointer; text-align: left;
  --c: var(--s-unassessed); --soft: var(--s-unassessed-soft); }
.node::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 4px; border-radius: var(--radius) var(--radius) 0 0; background: var(--c); }
.node:hover { box-shadow: var(--shadow-lift); transform: translateY(-2px); }
.node.on-path { background: linear-gradient(180deg, var(--soft), var(--raised) 70%); border-color: color-mix(in srgb, var(--c) 45%, var(--line)); }
.node.beyond { opacity: .45; }
.node .top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
.node .idx { font-size: 12px; font-weight: 700; color: var(--muted); letter-spacing: .04em; }
.node .stage { font-size: 14.5px; font-weight: 700; line-height: 1.25; }
.node .st { font-size: 11.5px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; color: var(--c); }
.node .step { font-size: 13.5px; line-height: 1.35; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.node .step code { font-size: 11.5px; }
.node .bar { display: flex; height: 6px; border-radius: 99px; overflow: hidden; background: var(--sunken); margin-top: auto; }
.node .bar i { display: block; height: 100%; background: var(--c); transition: width .5s var(--ease-out); }
.node .meta { display: flex; justify-content: space-between; gap: 6px; font-size: 12px; color: var(--muted); }
.node .seen { display: inline-flex; gap: 4px; align-items: center; color: var(--s-facilitated); font-weight: 650; }
.node .seen .icon { width: 14px; height: 14px; }
.ribbon { position: absolute; top: -10px; right: 10px; display: inline-flex; gap: 5px; align-items: center; padding: 3px 9px;
  border-radius: 99px; font-size: 11.5px; font-weight: 700; background: var(--s-hindered); color: var(--surface); box-shadow: var(--shadow); }
.ribbon .icon { width: 13px; height: 13px; }
.f-facilitated { --c: var(--s-facilitated); --soft: var(--s-facilitated-soft); }
.f-unpreventable { --c: var(--s-unpreventable); --soft: var(--s-unpreventable-soft); }
.f-partial { --c: var(--s-partial); --soft: var(--s-partial-soft); }
.f-hindered { --c: var(--s-hindered); --soft: var(--s-hindered-soft); }
.f-unassessed { --c: var(--s-unassessed); --soft: var(--s-unassessed-soft); }

/* Pills and chips */
.pill { display: inline-flex; align-items: center; gap: 6px; padding: 2px 9px; border-radius: 99px; font-size: 12px; font-weight: 650;
  background: var(--soft); color: var(--c); white-space: nowrap; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.chip { display: inline-flex; gap: 6px; align-items: center; padding: 2px 8px; border-radius: 7px; font-size: 12px;
  background: var(--sunken); color: var(--ink-2); text-decoration: none; border: 1px solid transparent; }
a.chip:hover { border-color: var(--line-strong); }
.chip b { font-family: var(--mono); font-weight: 600; font-size: 11.5px; color: var(--ink); }
.chip.gap { background: var(--s-facilitated-soft); color: var(--s-facilitated); }
.chip .lv { font-weight: 700; }

/* Questionnaire */
.toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 16px; }
.toolbar .search { flex: 1 1 260px; }
.toolbar .search input { width: 100%; }
.bulk { display: inline-flex; gap: 8px; align-items: center; font-size: 14px; margin-left: auto; }
.domain { border: 1px solid var(--line); border-radius: var(--radius); margin: 0 0 12px; background: var(--raised); overflow: hidden; }
.domain > summary { display: flex; align-items: center; gap: 12px; padding: 14px 18px; cursor: pointer; list-style: none; font-weight: 650; }
.domain > summary::-webkit-details-marker { display: none; }
.domain > summary .chev { transition: transform .25s var(--ease-out); color: var(--muted); }
.domain[open] > summary .chev { transform: rotate(180deg); }
.domain > summary .count { margin-left: auto; font-weight: 500; font-size: 13px; color: var(--muted); }
.domain > summary .mini { width: 90px; height: 6px; border-radius: 99px; background: var(--sunken); overflow: hidden; }
.domain > summary .mini i { display: block; height: 100%; background: var(--accent); transition: width .4s var(--ease-out); }
.control { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 24px; padding: 14px 18px; border-top: 1px solid var(--line); background: var(--surface); }
.control.changed { animation: flash 1.2s var(--ease-out); }
.control h3 { margin: 0; font-size: 14.5px; line-height: 1.35; }
.control h3 .cid { font-family: var(--mono); font-size: 12px; font-weight: 600; color: var(--muted); margin-right: 6px; }
.control p { margin: 4px 0 0; font-size: 13px; color: var(--ink-2); max-width: 72ch; }
.control .impact { font-size: 12.5px; color: var(--muted); margin-top: 8px; }
.control .impact b { color: var(--s-facilitated); }
.rate { display: flex; flex-direction: column; align-items: flex-end; justify-content: center; gap: 6px; }
.lvl { display: flex; gap: 4px; }
.lvl label { position: relative; }
.lvl input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
.lvl span { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--line-strong);
  background: var(--surface); font-weight: 650; font-size: 14px; cursor: pointer; }
.lvl label:hover span { border-color: var(--ink-2); }
.lvl input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
.lvl input:checked + span { background: var(--c); border-color: var(--c); color: var(--surface); transform: scale(1.04); }
.lvl .na span { width: 30px; color: var(--muted); }
.lvl .na input:checked + span { background: var(--sunken); border-color: var(--line-strong); color: var(--ink); }
.lvl-name { font-size: 12px; color: var(--muted); min-height: 1em; }
.range { display: flex; gap: 10px; align-items: center; }
.range input[type="range"] { width: 200px; accent-color: var(--accent); }
.range input[type="number"] { width: 84px; }
.empty { color: var(--muted); font-size: 14px; }

/* Priorities */
.priorities { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; counter-reset: prio; }
.prio { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; gap: 6px 16px; align-items: center; padding: 16px 18px;
  border-radius: var(--radius); border: 1px solid var(--line); background: var(--raised); }
.prio .rank { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; font-weight: 750; background: var(--accent-soft); color: var(--accent); }
.prio h3 { margin: 0; font-size: 15px; }
.prio h3 .cid { font-family: var(--mono); font-size: 12px; color: var(--muted); font-weight: 600; margin-right: 6px; }
.prio .facts { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 13px; color: var(--ink-2); margin-top: 4px; }
.prio .facts b { color: var(--ink); }
.prio .lift { display: inline-flex; align-items: center; gap: 6px; font-weight: 650; font-size: 13px; }
.prio .lift .from { color: var(--s-facilitated); } .prio .lift .to { color: var(--s-hindered); }
.prio details { grid-column: 2 / -1; font-size: 13px; }
.prio details summary { cursor: pointer; color: var(--accent); width: max-content; }
.prio.applied { opacity: .55; }

/* Tables */
.table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); }
.tbl { width: 100%; border-collapse: collapse; font-size: 13.5px; }
.tbl th { position: sticky; top: 0; text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted);
  background: var(--raised); padding: 10px 14px; border-bottom: 1px solid var(--line); white-space: nowrap; }
.tbl td { padding: 10px 14px; border-top: 1px solid var(--line); vertical-align: top; }
.tbl tr:first-child td { border-top: 0; }
.tbl td .nm { font-weight: 600; }
.tbl td .id { font-family: var(--mono); font-size: 12px; color: var(--muted); }
.table-more { margin: 10px 2px 0; font-size: 13px; }

/* Method */
.method .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
.method h3 { margin: 0 0 8px; font-size: 15px; }
.method p { margin: 0 0 10px; font-size: 14px; color: var(--ink-2); }

/* Drawer */
.scrim { position: fixed; inset: 0; background: rgba(8, 15, 22, .38); z-index: 40; animation: fade .2s ease-out; }
.drawer { position: fixed; top: 0; right: 0; bottom: 0; width: min(600px, 100vw); z-index: 41; background: var(--surface);
  box-shadow: -20px 0 60px -20px rgba(0, 0, 0, .35); display: flex; flex-direction: column; animation: slide .32s var(--ease-out); }
.drawer-head { display: flex; justify-content: space-between; gap: 12px; padding: 22px 24px 14px; border-bottom: 1px solid var(--line); }
.drawer-head h2 { margin: 0; font-size: 22px; letter-spacing: -.02em; }
.drawer-body { overflow-y: auto; padding: 16px 24px 32px; }
.drawer-body > p { color: var(--ink-2); font-size: 14px; }
.tech { padding: 14px 0; border-top: 1px solid var(--line); }
.tech:first-of-type { border-top: 0; }
.tech-head { display: flex; gap: 10px; align-items: baseline; justify-content: space-between; }
.tech-head .nm { font-weight: 650; }
.tech-head a { font-family: var(--mono); font-size: 12px; }
.tech .why { font-size: 13px; color: var(--ink-2); margin: 4px 0 0; }
.stack { display: flex; height: 8px; border-radius: 99px; overflow: hidden; background: var(--sunken); margin: 6px 0 4px; }
.stack i { display: block; height: 100%; background: var(--c); }

/* Toast and footer */
.toast { position: fixed; left: 50%; bottom: 24px; transform: translate(-50%, 160%); padding: 11px 18px; border-radius: 12px;
  background: var(--ink); color: var(--paper); font-size: 14px; box-shadow: var(--shadow-lift); opacity: 0; visibility: hidden;
  transition: transform .35s var(--spring), opacity .2s, visibility 0s .35s; z-index: 50; max-width: 90vw; }
.toast.show { transform: translate(-50%, 0); opacity: 1; visibility: visible; transition: transform .35s var(--spring), opacity .2s; }
.foot { margin: 48px 0 0; padding: 24px 0 40px; border-top: 1px solid var(--line); font-size: 12.5px; color: var(--muted); }
.foot p { margin: 0 0 6px; max-width: 110ch; }

@keyframes pop { from { opacity: 0; transform: translateY(-4px) scale(.98); } }
@keyframes fade { from { opacity: 0; } }
@keyframes slide { from { transform: translateX(40px); opacity: 0; } }
@keyframes flash { 0% { background: var(--accent-soft); } 100% { background: var(--surface); } }
@keyframes rise { from { opacity: 0; transform: translateY(8px); } }
.chain li, .kpi, .prio { animation: rise .5s var(--ease-out) both; }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
}

@media (max-width: 980px) {
  .hero { grid-template-columns: 1fr; }
  .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .method .cols { grid-template-columns: 1fr; }
  .control { grid-template-columns: 1fr; }
  .rate { align-items: flex-start; }
  .jump { display: none; }
}
@media (max-width: 560px) {
  .section { padding: 18px; }
  .gauges { flex-direction: column; }
  .gauge { width: 100%; }
  .lvl span { width: 34px; height: 34px; }
}

@media print {
  :root { --paper: #fff; }
  body { font-size: 11pt; }
  .masthead, .toolbar, .actions, .drawer, .scrim, .toast, .prio button, .seg, .bulk { display: none !important; }
  .section { box-shadow: none; break-inside: auto; border: 0; padding: 0; margin-top: 24pt; }
  .node, .kpi, .prio, .domain, .gauge { break-inside: avoid; box-shadow: none; }
  .domain:not([open]) { display: none; }
  .chain li, .kpi, .prio { animation: none; }
  a { color: inherit; text-decoration: none; }
}
{% endraw %}
